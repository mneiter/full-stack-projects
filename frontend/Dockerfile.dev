# Use official Node.js 20 base image
FROM node:20

# Set working directory inside the container
WORKDIR /app

# Copy dependency definitions first
COPY package*.json ./

# Upgrade npm to the latest version
RUN npm install -g npm@latest

# Install dependencies (with root permission handling)
RUN npm install --unsafe-perm

# Copy all application files
COPY . .

# Expose default Next.js dev and debug ports
EXPOSE 3000
EXPOSE 9229

# Start Next.js dev server with explicit port
CMD ["node", "--inspect=0.0.0.0:9229", "node_modules/.bin/next", "dev", "-p", "3000"]
