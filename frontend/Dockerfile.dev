# Use official Node.js 20 image as base
FROM node:20

# Set working directory inside the container
WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy all project files (except ignored ones)
COPY . .

# Expose default Next.js development port
EXPOSE 3000

# Run the development server
CMD ["npm", "run", "dev"]
